<h1 class="mb-2 text-2xl font-bold tracking-tight">Add a controller</h1>
<p class="mb-6 text-sm text-gray-600">Paste the Rachio device ID (find it in the Rachio app, or via the API). Useful for old controllers no longer on your account.</p>

<div class="max-w-lg rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
  <%= form_with model: @controller_record, url: controllers_path, scope: :device do |form| %>
    <% @controller_record.errors.full_messages.each do |message| %>
      <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"><%= message %></p>
    <% end %>
    <div class="mb-4">
      <%= form.label :rachio_id, "Rachio device ID", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= form.text_field :rachio_id, required: true, size: 40, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-emerald-500 focus:ring-emerald-500" %>
    </div>
    <%= form.submit "Add controller", class: "rounded-md bg-emerald-600 px-3.5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700 cursor-pointer" %>
  <% end %>
</div>

<p class="mt-6 text-sm"><%= link_to "Back", controllers_path, class: "text-emerald-700 hover:text-emerald-800 hover:underline" %></p>
