<header class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold tracking-tight">Rachio Controllers</h1>
  <div class="flex items-center gap-2">
    <%= button_to "Sync from Rachio account", sync_account_controllers_path, class: "rounded-md bg-emerald-600 px-3.5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700 cursor-pointer" %>
    <%= link_to "Add controller by ID", new_controller_path, class: "rounded-md bg-emerald-600 px-3.5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700" %>
  </div>
</header>

<% if notice %><p class="mb-4 rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800"><%= notice %></p><% end %>
<% if alert %><p class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"><%= alert %></p><% end %>

<% if @controllers.none? %>
  <p class="text-gray-600">No controllers yet. Sync your Rachio account, or add an old controller by its device ID.</p>
<% else %>
  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Name</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Model</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Status</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Zones</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Events</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Last synced</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @controllers.each do |controller| %>
          <tr class="odd:bg-white even:bg-gray-50">
            <td class="px-4 py-3"><%= link_to controller.name.presence || controller.rachio_id, controller, class: "font-medium text-emerald-700 hover:text-emerald-800 hover:underline" %></td>
            <td class="px-4 py-3"><%= controller.model %></td>
            <td class="px-4 py-3"><%= status_badge(controller.status) || "—" %></td>
            <td class="px-4 py-3"><%= controller.zones.count %></td>
            <td class="px-4 py-3"><%= number_with_delimiter controller.events.count %></td>
            <td class="px-4 py-3 whitespace-nowrap text-gray-500"><%= controller.last_synced_at ? "#{time_ago_in_words(controller.last_synced_at)} ago" : "never" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<%# Replaced hardware is a footnote, not part of the list you came to read, so
    it stays folded away behind a count until asked for. %>
<% if @retired.any? %>
  <div class="mt-3">
    <% if params[:show_retired].present? %>
      <%= link_to "Hide retired controllers", controllers_path, class: "text-sm text-gray-500 hover:text-emerald-700 hover:underline" %>
    <% else %>
      <%= link_to "Show #{@retired.count} retired #{'controller'.pluralize(@retired.count)}", controllers_path(show_retired: 1), class: "text-sm text-gray-500 hover:text-emerald-700 hover:underline" %>
    <% end %>
  </div>
<% end %>

<% if @retired.any? && params[:show_retired].present? %>
  <p class="mb-3 mt-4 text-sm text-gray-600">Devices that have been replaced. Their history lives on the controller that took over — open that controller to browse it or undo the merge.</p>
  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Name</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Model</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Serial</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">In service</th>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">History merged into</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @retired.each do |controller| %>
          <tr class="odd:bg-white even:bg-gray-50 text-gray-500">
            <td class="px-4 py-3 font-medium text-gray-700"><%= controller.name.presence || controller.rachio_id %></td>
            <td class="px-4 py-3"><%= controller.model %></td>
            <td class="px-4 py-3"><%= controller.serial_number.presence || "—" %></td>
            <td class="px-4 py-3 whitespace-nowrap"><%= controller.rachio_created_at&.to_date&.strftime("%b %Y") || "—" %></td>
            <td class="px-4 py-3">
              <%= link_to controller.merged_into.name, controller.merged_into, class: "font-medium text-emerald-700 hover:text-emerald-800 hover:underline" %>
              <span class="text-gray-400">(<%= number_with_delimiter controller.merged_events_count %> events)</span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
