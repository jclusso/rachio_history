<%# locals: days ({Date => minutes}), from:, to: (Dates) %>
<% first = from.beginning_of_week(:sunday) %>
<div class="overflow-x-auto rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
  <div class="flex gap-[3px]">
    <% (first..to).each_slice(7) do |week| %>
      <div class="flex flex-col gap-[3px]">
        <% week.each do |day| %>
          <div class="h-3 w-3 rounded-sm <%= day < from ? 'bg-transparent' : heat_class(days[day]) %>"
               title="<%= day.strftime('%b %-d, %Y') %> — <%= days[day].to_i %> min"></div>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="mt-3 flex items-center gap-2 text-xs text-gray-500">
    <span><%= from.strftime("%b %Y") %></span>
    <span class="ml-auto">Less</span>
    <% [ 0, 5, 20, 40, 90, 150 ].each do |m| %><div class="h-3 w-3 rounded-sm <%= heat_class(m) %>"></div><% end %>
    <span>More</span>
  </div>
</div>
