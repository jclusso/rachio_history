<p class="mb-4 text-sm"><%= link_to "← #{@controller.name}", @controller, class: "text-emerald-700 hover:text-emerald-800 hover:underline" %></p>

<h1 class="mb-4 text-2xl font-bold tracking-tight"><%= @controller.name %> — Event history</h1>

<%= form_with url: history_controller_path(@controller), method: :get, class: "mb-3 flex flex-wrap items-center gap-4" do |form| %>
  <%= form.select :zone_id, options_from_collection_for_select(@zones, :id, :name, params[:zone_id]),
        { include_blank: "All zones" }, onchange: "this.form.requestSubmit()", class: "rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm shadow-sm focus:border-emerald-500 focus:ring-emerald-500" %>
  <label class="flex items-center gap-2 text-sm text-gray-700"><%= form.check_box :runs_only, { checked: params[:runs_only].present?, onchange: "this.form.requestSubmit()", class: "rounded border-gray-300 text-emerald-600 focus:ring-emerald-500" }, "1", "" %> Zone runs only</label>
<% end %>

<%= render partial: "events/table", locals: { events: @events } %>
