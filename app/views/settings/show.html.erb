<h1 class="mb-2 text-2xl font-bold tracking-tight">Settings</h1>
<p class="mb-6 text-sm text-gray-600">Your Rachio API key is stored encrypted in this app's database. Get it from the Rachio app under Account Settings, or at <a href="https://app.rach.io/" class="text-emerald-700 hover:underline">app.rach.io</a>.</p>

<% if notice %><p class="mb-4 rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800"><%= notice %></p><% end %>

<div class="max-w-lg rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
  <%= form_with model: @setting, url: settings_path, method: :patch, scope: :setting do |form| %>
    <% @setting.errors.full_messages.each do |message| %>
      <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"><%= message %></p>
    <% end %>

    <div class="mb-4">
      <%= form.label :rachio_api_key, "Rachio API key", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= form.password_field :rachio_api_key, value: nil, autocomplete: "off", required: true, placeholder: @setting.rachio_api_key_hint || "Not set", class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-emerald-500 focus:ring-emerald-500" %>
      <p class="mt-1 text-xs text-gray-500">
        <% if @setting.persisted? %>
          A key is configured. Entering a new one replaces it.
        <% else %>
          No key configured yet, so syncing is disabled.
        <% end %>
      </p>
    </div>

    <%= form.submit "Save key", class: "rounded-md bg-emerald-600 px-3.5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700 cursor-pointer" %>
  <% end %>
</div>
