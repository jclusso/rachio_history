<%# locals: days ({Date => minutes}), from:, to: (Dates), breakdown: ({Date => [[zone, minutes]]}, optional) %>
<% first = from.beginning_of_week(:sunday) %>
<% breakdown = local_assigns[:breakdown] || {} %>
<% weeks = (first..to).each_slice(7).to_a %>
<%# One equal-width column per week, so the year stretches to fill whatever
    width the card gives it instead of stopping at a fixed 12px per day.
    grid-auto-columns is set inline rather than via auto-cols-fr: if that
    utility ever fails to generate, the columns collapse and the grid
    disappears entirely. The min-width keeps squares from becoming slivers on
    a phone — below it the wrapper scrolls. %>
<% track = "grid-auto-columns: minmax(0, 1fr)" %>
<%# relative: the tooltip is positioned against this card, so it can escape
    the horizontal scroller below without being clipped by it. %>
<div class="relative rounded-lg border border-gray-200 bg-white p-4 shadow-sm" data-controller="heatmap">
  <div class="overflow-x-auto">
    <div class="min-w-[640px]">
      <div class="mb-1 grid grid-flow-col grid-rows-1 gap-[3px]" style="<%= track %>">
        <% previous_month = nil %>
        <% weeks.each do |week| %>
          <%# Label the first week of each month. A column is far narrower than
              "Sep", so the text is absolutely positioned and allowed to run
              over the empty labels beside it, the way GitHub's does. %>
          <div class="relative h-4">
            <% if week.first.month != previous_month %>
              <span class="absolute left-0 top-0 whitespace-nowrap text-[11px] leading-4 text-gray-500"><%= week.first.strftime("%b") %></span>
            <% end %>
          </div>
          <% previous_month = week.first.month %>
        <% end %>
      </div>

      <%# grid-flow-col over 7 rows fills each week top-to-bottom before moving
          right, so days are emitted in plain chronological order. %>
      <div class="grid grid-flow-col grid-rows-7 gap-[3px]" style="<%= track %>">
        <% weeks.flatten.each do |day| %>
          <% if day < from %>
            <div class="aspect-square rounded bg-transparent"></div>
          <% else %>
            <div class="aspect-square rounded <%= heat_class(days[day]) %>"
                 data-action="mouseenter->heatmap#show mouseleave->heatmap#hide"
                 data-date="<%= day.strftime('%A, %b %-d, %Y') %>"
                 data-total="<%= days[day].to_i %>"
                 data-runs="<%= (breakdown[day] || []).to_json %>"></div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
  <div data-heatmap-target="tooltip"
       class="pointer-events-none absolute left-0 top-0 z-20 hidden min-w-[10rem] rounded-md bg-gray-900 px-2.5 py-1.5 text-xs text-white shadow-lg"></div>
  <%# The month row above replaces the old "Aug 2025" start-of-range caption. %>
  <div class="mt-3 flex items-center justify-end gap-2 text-xs text-gray-500">
    <span>Less</span>
    <% [ 0, 5, 20, 40, 90, 150 ].each do |m| %><div class="h-3 w-3 rounded-sm <%= heat_class(m) %>"></div><% end %>
    <span>More</span>
  </div>
</div>
