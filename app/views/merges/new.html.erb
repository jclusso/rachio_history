<p class="mb-4 text-sm"><%= link_to "← #{@controller.name}", @controller, class: "text-emerald-700 hover:text-emerald-800 hover:underline" %></p>

<h1 class="mb-2 text-2xl font-bold tracking-tight">Merge <%= @controller.name %> into <%= @successor.name %></h1>
<p class="mb-6 max-w-3xl text-sm text-gray-600">
  Every event on <%= @controller.name %> moves to <%= @successor.name %> and is re-linked to the matching zone there, giving
  the yard one continuous history instead of two halves. <%= @controller.name %> stays on the list as retired hardware, and
  the merge can be undone from <%= @successor.name %> at any time.
</p>

<div class="mb-6 grid gap-4 sm:grid-cols-2">
  <% [ [ "Moving from", @controller ], [ "Moving to", @successor ] ].each do |label, device| %>
    <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
      <div class="text-xs font-semibold uppercase tracking-wider text-gray-500"><%= label %></div>
      <div class="mt-1 text-lg font-bold tracking-tight text-gray-900"><%= device.name %></div>
      <dl class="mt-3 space-y-1.5 text-sm">
        <%= detail_row "Model", device.model %>
        <%= detail_row "Serial", device.serial_number %>
        <%= detail_row "Events", number_with_delimiter(device.events.count) %>
        <%= detail_row "History", event_span(device) %>
      </dl>
    </div>
  <% end %>
</div>

<% if @overlapping_days.any? %>
  <div class="mb-6 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
    <p class="font-semibold">Both controllers watered on <%= pluralize @overlapping_days.count, "day" %>.</p>
    <p class="mt-1">
      <%= @overlapping_days.first(6).map { |day| day.strftime("%b %-d, %Y") }.to_sentence %><%= " and more" if @overlapping_days.count > 6 %>.
      These devices ran side by side rather than one replacing the other, so merged daily totals will add both together. Merge anyway only if that is what you want.
    </p>
  </div>
<% end %>

<h2 class="mb-1 text-lg font-semibold">Zone pairing</h2>
<p class="mb-3 max-w-3xl text-sm text-gray-600">Zones are matched by number, then by name. Anything left unmatched keeps its history but arrives unassigned, ready to link by hand from the “Unmatched zone names” table on <%= @successor.name %>.</p>

<% unmatched = @pairing.count { |_zone, successor_zone| successor_zone.nil? } %>
<div class="mb-6 overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
  <table class="min-w-full divide-y divide-gray-200 text-sm">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500"><%= @controller.name %></th>
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Events</th>
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500"></th>
        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500"><%= @successor.name %></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @pairing.each do |zone, successor_zone| %>
        <tr class="<%= "bg-amber-50/50" if successor_zone.nil? %>">
          <td class="px-4 py-2.5"><%= zone_number_badge zone.number %><span class="font-medium"><%= zone.name %></span></td>
          <td class="px-4 py-2.5 whitespace-nowrap text-gray-500"><%= number_with_delimiter zone.events.count %></td>
          <td class="px-4 py-2.5 text-gray-300">→</td>
          <td class="px-4 py-2.5">
            <% if successor_zone %>
              <%= zone_number_badge successor_zone.number %><span class="font-medium"><%= successor_zone.name %></span>
              <% if successor_zone.name != zone.name %>
                <span class="ml-1 inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">keeps “<%= zone.name.truncate(28) %>” as an alias</span>
              <% end %>
            <% else %>
              <span class="text-amber-700">No matching zone — history arrives unassigned</span>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @pairing.none? %>
        <tr><td colspan="4" class="px-4 py-6 text-center text-gray-500"><%= @controller.name %> has no zones.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="flex flex-wrap items-center gap-3">
  <%= button_to "Merge #{number_with_delimiter @controller.events.count} events into #{@successor.name}",
        controller_merge_path(@controller, successor_id: @successor.id),
        class: "rounded-md bg-emerald-600 px-3.5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700 cursor-pointer",
        data: { turbo_confirm: "Move #{number_with_delimiter @controller.events.count} events from #{@controller.name} to #{@successor.name}#{unmatched.positive? ? ", leaving #{pluralize unmatched, 'zone'} unassigned" : ""}?" } %>
  <%= link_to "Cancel", @controller, class: "rounded-md border border-gray-300 bg-white px-3.5 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50" %>
</div>
